{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.65.0",
          "rules": [
            {
              "id": "python.django.security.injection.sql.django-raw-sql",
              "shortDescription": {
                "text": "Django Raw SQL Injection"
              },
              "properties": {
                "security-severity": "8.5"
              }
            },
            {
              "id": "generic.secrets.security.hardcoded-jwt-token",
              "shortDescription": {
                "text": "Hardcoded JWT Token Detected"
              },
              "properties": {
                "security-severity": "7.0"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.django.security.injection.sql.django-raw-sql",
          "level": "error",
          "message": {
            "text": "User input from request.GET formatted directly into raw SQL string."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/views/users.py"
                },
                "region": {
                  "startLine": 42,
                  "endLine": 44,
                  "snippet": {
                    "text": "User.objects.raw('SELECT * FROM users WHERE id = ' + user_id)"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "generic.secrets.security.hardcoded-jwt-token",
          "level": "warning",
          "message": {
            "text": "Potential hardcoded JWT auth token detected in configuration."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config/settings.py"
                },
                "region": {
                  "startLine": 18,
                  "endLine": 18,
                  "snippet": {
                    "text": "AUTH_TOKEN = 'synthetic_test_token_sample'"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
