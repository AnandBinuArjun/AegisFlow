# ==============================================================================
# AegisFlow Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env for local development. Never commit real secrets.
# All values here are safe placeholders.
# ==============================================================================

# Environment mode: development, staging, production
ENVIRONMENT=development

# Application Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins (JSON array or comma-separated list, NO wildcards with credentials)
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database URL
# For local dev without Docker, SQLite fallback is supported: sqlite+aiosqlite:///./local_data/aegisflow.db
# For PostgreSQL: postgresql+asyncpg://aegis_user:aegis_dev_password@localhost:5432/aegisflow
DATABASE_URL=sqlite+aiosqlite:///./local_data/aegisflow.db
DATABASE_SYNC_URL=sqlite:///./local_data/aegisflow.db

# Redis URL (optional for MVP modular monolith mode)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
# DEVELOPMENT_AUTH_MODE allows mock tokens only when ENVIRONMENT=development.
# It is strictly prohibited and fails closed in production.
DEVELOPMENT_AUTH_MODE=true
JWT_SECRET_KEY=dev-only-secret-key-change-in-production-min32bytes-placeholder!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Gateway Configuration
# AegisFlow operates cleanly without an LLM. Default provider is "mock".
# Supported providers: mock, openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=mock-model-v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Ingestion Constraints
MAX_INGESTION_PAYLOAD_BYTES=10485760 # 10MB
